{
  "buildCommand": null,
  "outputDirectory": ".",
  "devCommand": null,
  "installCommand": null,
  "rewrites": [
    {
      "source": "/phrases-learning.html",
      "destination": "/phrases-learning.html"
    },
    {
      "source": "/reading-cassie.html",
      "destination": "/reading-cassie.html"
    },
    {
      "source": "/scripts/:path*",
      "destination": "/scripts/:path*"
    },
    {
      "source": "/:file*.:ext",
      "destination": "/:file*.:ext"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/vocab_data.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}